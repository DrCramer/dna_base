POSTGRES_DB=dna_registry
POSTGRES_USER=dna
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql+asyncpg://dna:replace-with-a-strong-db-password@postgres:5432/dna_registry
SECRET_KEY=replace-with-a-long-random-secret
STORAGE_DIR=/app/data
APP_PORT=4001
CORS_ORIGINS=["http://localhost:4001","http://127.0.0.1:4001","http://localhost:4000","http://127.0.0.1:4000"]

PRINT_DATA_DIR=/app/data/print
PRINT_JOB_TTL_HOURS=2
PRINT_MAX_UPLOAD_MB=500
PRINT_MAX_FILES=2000
PRINT_MAX_SINGLE_FILE_MB=50
PRINT_MAX_UNPACKED_MB=1500
PRINT_MAX_ZIP_DEPTH=8
PRINT_CONVERT_WORKERS=1
PRINT_CONVERSION_TIMEOUT_SECONDS=120
PRINT_REQUIRE_SAME_PAGE_SIZE=
PRINT_ALLOW_DROP_BLANK_EXTRA_PAGES=true

# Разрешает доступ к API с локальных/частных IP при запуске на сервере в LAN.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+|192\.168\.\d+\.\d+)(:\d+)?$
